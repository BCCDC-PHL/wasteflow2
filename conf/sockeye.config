/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for Sockeye
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/seqqc -profile sockeye,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'sockeye'
    config_profile_description = 'sockeye'
}

process {
    executor = 'slurm'
    clusterOptions = '--account=st-naprysta-1 --nodes=1'  // Change this to your account name
    containerOptions = '--cleanenv --no-home'

    withName:'MINIMAP2_ALIGN' {
        memory = '64 GB'
        cpus = 32
    }
    
    withName: 'ASSIGN_SEROTYPES' {
        cpus = 36
        memory = '72 GB'
        ext.score_thresh = 90
    }

    withName: 'SEQKIT_GREP' {
        memory = '64 GB'
        cpus = 24
    }

}

executor {
    queueSize = 100
    submitRateLimit = '10 sec'
}


    withName: CAT_FASTQ {
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/${meta.id}/cat_fastq" },
            mode: params.publish_dir_mode,
            pattern: "*",
            enabled: false,
        ]
    }

    withName: FASTQC_RAW {
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/${meta.id}/fastqc/raw" },
            mode: params.publish_dir_mode,
            pattern: "*",
        ]
        ext.args   = '--quiet'
    }

    withName: FASTQC_TRIM {
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/${meta.id}/fastqc/trim" },
            mode: params.publish_dir_mode,
            pattern: "*",
        ]
        ext.args   = '--quiet'
    }

    withName: FASTP {
        publishDir = [
            [
                path: { "${params.outdir}/${params.run_id}/${meta.id}/fastp" },
                mode: params.publish_dir_mode,
                pattern: "*.{json,html}",
            ],
            [
                path: { "${params.outdir}/${params.run_id}/${meta.id}/fastp/log" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
            ],
            [
                path: { "${params.outdir}/${params.run_id}/${meta.id}/fastp" },
                mode: params.publish_dir_mode,
                pattern: "*.fail.fastq.gz",
                enabled: params.save_trimmed_fail,
            ],
        ]
        ext.args   = '--cut_front --cut_tail --trim_poly_x --cut_mean_quality 20 --qualified_quality_phred 20 --unqualified_percent_limit 10 --length_required 70'
    }

    withName: 'BCCDCPHL_WASTEFLOW2:WASTEFLOW:READ_PROCESSING:SEQKIT_STATS_RAW' {

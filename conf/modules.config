        ]
    }

    withName: 'BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_SARS_COV2:GUNZIP_GFF|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_A:GUNZIP_GFF|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_B:GUNZIP_GFF|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_COMBINED:GUNZIP_GFF' {

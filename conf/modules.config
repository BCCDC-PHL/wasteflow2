            enabled: false,
        ]
    }
    

    withName: 'BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_SARS_COV2:UNTAR_BOWTIE_INDEX|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_A:UNTAR_BOWTIE_INDEX|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_B:UNTAR_BOWTIE_INDEX|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_COMBINED:UNTAR_BOWTIE_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/prepare_genome/untar_bowtie_index" },
            mode: params.publish_dir_mode,

    withName: 'BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_SARS_COV2:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_A:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_B:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_RSV_COMBINED:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_PANEL_CONTROL:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_H1N1:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_H3N2:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_H5N1:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_H1N1:CUSTOM_GETCHROMSIZES_SEGMENTS|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_H3N2:CUSTOM_GETCHROMSIZES_SEGMENTS|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_H1N1:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_H3N2:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_H5N1:CUSTOM_GETCHROMSIZES_SEGMENTS|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_FLU_B_VIC:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_FLU_B_VIC:CUSTOM_GETCHROMSIZES_SEGMENTS|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_FLU_B_YAM:CUSTOM_GETCHROMSIZES|BCCDCPHL_WASTEFLOW2:WASTEFLOW:GENOME_PREPARATION:PREPARE_GENOME_FLU_B_YAM:CUSTOM_GETCHROMSIZES_SEGMENTS' {

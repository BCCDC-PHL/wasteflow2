/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BCCDC-PHL/wasteflow2 Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // TODO nf-core: Specify your pipeline's command line flags
    // Input options
    input                        = null

    // MultiQC options
    skip_multiqc                 = false
    multiqc_config               = null
    multiqc_title                = null
    multiqc_logo                 = null
    max_multiqc_email_size       = '25.MB'
    multiqc_methods_description  = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    trace_report_suffix          = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    // Config options
    config_profile_name          = null
    config_profile_description   = null

    custom_config_version        = 'master'
    custom_config_base           = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact       = null
    config_profile_url           = null

    // Schema validation default options
    validate_params              = true


    // Prepare Genome options
    genomes                      = [
        'MN908947.3': [
            name: 'MN908947.3',
            fasta: '/scratch/st-jzlosnik-1/mzanwar/safeguard/workflow/databases/GCA_009858895.3_ASM985889v3_genomic.200409.fna.gz',
            gff: '/scratch/st-jzlosnik-1/mzanwar/safeguard/workflow/databases/GCA_009858895.3_ASM985889v3_genomic.200409.gff.gz',
            nextclade_dataset_name: 'sars-cov-2',
            nextclade_dataset_tag: 'latest',
            bed: "${projectDir}/assets/sarscov2_genes.bed",
            segment_gffs: null,
        ],
        'OP975389.1': [
            name: 'OP975389.1',
            fasta: '/scratch/st-jzlosnik-1/mzanwar/safeguard/workflow/databases/OP975389.1_RSVb.fna.gz',
            gff: '/scratch/st-jzlosnik-1/mzanwar/safeguard/workflow/databases/OP975389.1_RSVb.gff.gz',
            nextclade_dataset_name: 'rsv_b',
            nextclade_dataset_tag: 'latest',
            bed: "${projectDir}/assets/rsvB_genes.bed",
            segment_gffs: null,
        ],
        'PP109421.1': [
            name: 'PP109421.1',
            fasta: '/scratch/st-jzlosnik-1/mzanwar/safeguard/workflow/databases/PP109421.1_RSVa.fna.gz',
            gff: '/scratch/st-jzlosnik-1/mzanwar/safeguard/workflow/databases/PP109421.1_RSVa.gff.gz',
            nextclade_dataset_name: 'rsv_a',
            nextclade_dataset_tag: 'latest',
            segments_bed: "${projectDir}/assets/rsvA_genes.bed",
            segment_gffs: null,
        ],
        'RSV_combined': [
            name: 'RSV_combined',
            fasta: '/scratch/st-jzlosnik-1/mzanwar/safeguard/workflow/databases/OP975389.1_PP109421.1.fna.gz',
            gff: null,
            nextclade_dataset_name: null,
            nextclade_dataset_tag: null,
            bed: null,
            segment_gffs: null,
        ],
        'panel_control_db': [
            name: 'panel_control_db',
            fasta: '/scratch/st-jzlosnik-1/mzanwar/safeguard/workflow/databases/panel_plus_control.fa.gz',
            gff: null,
            nextclade_dataset_name: null,
            nextclade_dataset_tag: null,
